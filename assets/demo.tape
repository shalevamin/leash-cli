# Optional VHS equivalent. Run from the repository root after pnpm build.
# scripts/demo-session.mjs creates and removes its own isolated HOME.
Output assets/demo.gif
Set Shell "bash"
Set FontFamily "IBM Plex Mono"
Set FontSize 18
Set Width 1000
Set Height 470
Set Padding 24
Set BorderRadius 0
Set WindowBar None
Set Theme { "name": "Leash", "background": "#1A1A17", "foreground": "#F6F5F1", "black": "#1A1A17", "red": "#B42318", "green": "#1E7F5C", "yellow": "#F2A900", "blue": "#4A4843", "magenta": "#66635B", "cyan": "#8C887E", "white": "#F6F5F1", "brightBlack": "#66635B", "brightRed": "#B42318", "brightGreen": "#1E7F5C", "brightYellow": "#F2A900", "brightBlue": "#4A4843", "brightMagenta": "#66635B", "brightCyan": "#8C887E", "brightWhite": "#FFFFFF" }
Hide
Type "node scripts/demo-session.mjs"
Enter
Show
Sleep 7s
