    "hono": "^4.8.0",
    "ignore": "7.0.12",
    "sharp": "0.35.5",
    "typescript": "5.9.3"
  },
  "bin": {
    "leash": "bin/leash.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.1",
    "vitest": "4.1.12"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
